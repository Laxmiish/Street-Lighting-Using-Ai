# ==============================================================================
# LuminaAI — Production Deployment Environment Variables
# ==============================================================================

# Database Configuration (PostgreSQL 14+ / TimescaleDB)
# For local Docker: postgresql://postgres:postgres123@timescaledb:5432/street_lighting_db
# For Neon / Supabase / Render: postgresql://[user]:[password]@[host]:5432/[dbname]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/street_lighting_db

# Granular Database Connection Parameters (Fallback if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=street_lighting_db
DB_SSL=false
DB_POOL_MAX=20
DEBUG_SQL=false

# Backend Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# Frontend Environment Variable (Set when deploying frontend to Vercel/Netlify separate from backend)
# Example: https://lumina-backend.onrender.com
# Leave blank or set to /api when using Docker Compose with Nginx reverse proxy
VITE_API_URL=/api
