# Primary Database Connection String (Direct connection URI for PostgreSQL + TimescaleDB)
DATABASE_URL=postgresql://postgres:postgres123@127.0.0.1:5432/street_lighting_db

# Granular Database Connection Parameters
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=street_lighting_db
DB_SSL=false
DB_POOL_MAX=20
DEBUG_SQL=false

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*
